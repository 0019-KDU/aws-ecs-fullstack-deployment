# Copy this file to .env and fill in values before running docker compose.
# NEVER commit .env to git.

# ── MySQL ──────────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=RootSecret!Change
MYSQL_DATABASE=student_portal
MYSQL_USER=student_portal
MYSQL_PASSWORD=AppSecret!Change

# ── Backend ────────────────────────────────────────────────────────────────────
# Origins the browser is allowed to send requests from (comma-separated).
CORS_ALLOWED_ORIGINS=http://localhost:80,http://localhost
